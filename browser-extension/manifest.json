{
  "manifest_version": 3,
  "name": "TMA-Safe · Browser filling",
  "version": "0.2.3",
  "description": "Fill a login with approval from your unlocked TMA-Safe vault.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:19473/*"],
  "action": {"default_popup": "popup.html", "default_title": "Fill with TMA-Safe"},
  "browser_specific_settings": {"gecko": {"id": "tma-safe@tmapps.local", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}
}
