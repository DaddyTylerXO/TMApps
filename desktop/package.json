{
  "name": "tmapps-launcher",
  "version": "1.12.1",
  "private": true,
  "description": "Your TMApps library for macOS and Linux.",
  "author": "DaddyTylerXO",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "electron-builder --publish never",
    "release-metadata": "node scripts/release-metadata.cjs"
  },
  "dependencies": {
    "tar": "7.5.22"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.3"
  },
  "build": {
    "appId": "com.tmapps.launcher",
    "productName": "TMApps Launcher",
    "files": [
      "electron/**/*",
      "ui/**/*",
      "assets/icon.png",
      "assets/TMA-Mail.png",
      "catalog.json",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "TMApps-Launcher-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "TMApps Launcher",
      "sign": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "executableName": "tmapps-launcher",
      "maintainer": "DaddyTylerXO",
      "desktop": {
        "entry": {
          "Name": "TMApps Launcher",
          "Comment": "Install, open, and update your TMApps"
        }
      }
    }
  }
}
