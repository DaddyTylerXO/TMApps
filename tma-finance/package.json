{
  "name": "tma-finance",
  "productName": "TMA-Finance",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Personal finance and investment desktop workspace",
  "author": "DaddyTylerXO",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "preview:web": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check dist/app.js && node --check dist/core.js && node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/market.cjs",
    "dist:win": "electron-builder --win portable zip --x64 --publish never"
  },
  "build": {
    "appId": "com.tma.finance",
    "productName": "TMA-Finance",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "dist/assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "TMA-Finance-${version}-Windows.exe"
    },
    "artifactName": "TMA-Finance-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.10"
  }
}
