{
  "name": "tma-cut",
  "version": "0.2.0",
  "private": true,
  "description": "A calmer home for your video edits.",
  "author": "DaddyTylerXO",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "electron-builder --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.3"
  },
  "build": {
    "appId": "com.tmapps.cut",
    "productName": "TMA-Cut",
    "executableName": "TMA-Cut",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "files": [
      "electron/**",
      "ui/**",
      "assets/**",
      "package.json",
      "THIRD_PARTY.md",
      "docs/KB Library.md",
      "docs/KB Library.docx",
      "docs/kb.json",
      "docs/screenshots/**"
    ],
    "artifactName": "TMA-Cut-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "tar.gz",
        "dmg"
      ],
      "category": "public.app-category.video",
      "icon": "assets/icon.png",
      "identity": "-"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "assets/icon.png",
      "maintainer": "DaddyTylerXO",
      "executableName": "TMA-Cut"
    },
    "afterPack": "scripts/prune-package.cjs"
  }
}
