{
  "name": "agent-office",
  "version": "0.1.0",
  "private": true,
  "description": "A live AI agent workspace with OpenAI and local ArtCraft integrations.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/serve.cjs",
    "test": "node --test tests/*.test.cjs",
    "package": "electron-builder --win nsis",
    "package:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^30.1.2"
  },
  "build": {
    "appId": "local.agentoffice.desktop",
    "productName": "Agent Office",
    "files": [
      "electron/**/*",
      "src/**/*"
    ],
    "asarUnpack": [
      "electron/spotify.ps1"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Agent Office Setup ${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Office",
      "uninstallDisplayName": "Agent Office",
      "deleteAppDataOnUninstall": false
    }
  }
}
