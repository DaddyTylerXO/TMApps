{
  "name": "tma-safe",
  "version": "0.3.0",
  "private": true,
  "description": "A calmer, local home for your passwords.",
  "author": "DaddyTylerXO",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.3"
  },
  "build": {
    "appId": "com.tmapps.safe",
    "productName": "TMA-Safe",
    "executableName": "TMA-Safe",
    "files": ["electron/**", "ui/**", "assets/**", "browser-extension/**", "README.md", "SECURITY.md", "docs/kb.json", "docs/releases.json"],
    "directories": {"output": "dist"},
    "artifactName": "TMA-Safe-${version}-${os}-${arch}.${ext}",
    "win": {"target": ["zip"], "icon": "assets/icon.ico", "signExecutable": false},
    "mac": {"target": ["dmg", "zip"], "icon": "assets/icon.png", "category": "public.app-category.utilities", "identity": "-"},
    "dmg": {"sign": false},
    "linux": {"target": ["AppImage", "tar.gz"], "icon": "assets/icon.png", "category": "Utility", "maintainer": "DaddyTylerXO"}
  }
}
