{
  "name": "tma-padlock",
  "version": "0.4.0",
  "private": true,
  "description": "Your codes, kept close. An encrypted local authenticator.",
  "author": "DaddyTylerXO",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "electron-builder --publish never",
    "test:performance": "node scripts/performance.cjs"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.3"
  },
  "build": {
    "appId": "com.tmapps.padlock",
    "productName": "TMA-Padlock",
    "executableName": "TMA-Padlock",
    "files": [
      "electron/**",
      "ui/**",
      "assets/**",
      "README.md",
      "SECURITY.md"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "TMA-Padlock-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "zip"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "DaddyTylerXO"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
