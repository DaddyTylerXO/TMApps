<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TMApps Launcher" Width="1120" Height="720" MinWidth="900" MinHeight="580" Background="#111214" Foreground="#F2F3F4" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#151719"/><Setter Property="Foreground" Value="#D9DCDE"/><Setter Property="BorderBrush" Value="#383B3F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,10"/><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B9D8CE"/><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#BEF18A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0D0E10"/><Setter Property="Foreground" Value="#E7E9EB"/><Setter Property="BorderBrush" Value="#383B3F"/><Setter Property="Padding" Value="12,9"/><Setter Property="CaretBrush" Value="#BEF18A"/></Style>
  <DataTemplate x:Key="AppList">
   <Border BorderBrush="#35373B" BorderThickness="1" Margin="0,0,0,12" Background="#141517">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="33"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border BorderBrush="#35373B" BorderThickness="0,0,0,1" Padding="16,0"><DockPanel><TextBlock Text="{Binding Number}" Foreground="{Binding Accent}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="{Binding Category}" Foreground="#8C9296" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel></Border>
     <Grid Grid.Row="1" Margin="20,23">
      <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="184"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
      <Border Width="56" Height="56" Background="{Binding PreviewBackground}" CornerRadius="9" VerticalAlignment="Top"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" Margin="0,0,25,0"><TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="#9B9FA4" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,7,0,0"/><TextBlock Text="{Binding Detail}" Foreground="#A6B2AC" FontSize="11" TextWrapping="Wrap" Margin="0,11,0,0"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="0,4,12,0"><TextBlock Text="{Binding Status}" Foreground="{Binding Accent}" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap"/><TextBlock Text="{Binding VersionLabel}" Foreground="#D7DADD" FontSize="12" Margin="0,14,0,0"/><TextBlock Text="{Binding UpdatedLabel, StringFormat=Updated {0}}" Foreground="#90979D" FontSize="11" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="3" VerticalAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><Button Content="{Binding Action}" IsEnabled="{Binding CanAct}" Tag="{Binding Id}" Click="AppAction" FontWeight="Bold"/><Button Grid.Column="1" Content="•••" Tag="{Binding Id}" Click="AppMenu" ToolTip="Application options" Margin="6,0,0,0" Padding="0,10" AutomationProperties.Name="Application options"/></Grid><Button Content="Cancel" Tag="{Binding Id}" Click="CancelInstall" Visibility="{Binding CancelVisibility}" Margin="0,6,0,0"/></StackPanel>
     </Grid>
    </Grid>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="AppCard">
   <Border Margin="0,0,12,12" BorderBrush="#35373B" BorderThickness="1" Background="#141517">
    <StackPanel>
     <Border BorderBrush="#35373B" BorderThickness="0,0,0,1" Padding="18,10"><TextBlock Text="{Binding Number}" Foreground="{Binding Accent}" FontFamily="Consolas" FontSize="10"/></Border>
     <StackPanel Margin="20,22">
      <DockPanel><Border Width="54" Height="54" Background="{Binding PreviewBackground}" CornerRadius="8" Margin="0,0,14,0"><TextBlock Text="{Binding Glyph}" Foreground="{Binding Accent}" FontFamily="Segoe MDL2 Assets" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Foreground="#90979D" FontSize="11" Margin="0,4,0,0"/></StackPanel></DockPanel>
      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#9B9FA4" FontSize="12" LineHeight="20" Margin="0,17,0,0" MinHeight="44"/>
      <TextBlock Text="{Binding Status}" Foreground="{Binding Accent}" FontFamily="Consolas" FontSize="10" Margin="0,18,0,0"/>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="{Binding VersionLabel}" FontSize="12" Foreground="#A8ADB2"/><TextBlock Text=" · " Foreground="#A8ADB2"/><TextBlock Text="{Binding UpdatedLabel}" FontSize="12" Foreground="#A8ADB2"/></StackPanel>
      <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Foreground="#9BA8A1" FontSize="11" Margin="0,10,0,0" MinHeight="16"/>
      <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><Button Content="{Binding Action}" IsEnabled="{Binding CanAct}" Tag="{Binding Id}" Click="AppAction" FontWeight="Bold"/><Button Grid.Column="1" Content="Cancel" Tag="{Binding Id}" Click="CancelInstall" Visibility="{Binding CancelVisibility}" Margin="6,0,0,0"/><Button Grid.Column="2" Content="•••" Tag="{Binding Id}" Click="AppMenu" Margin="6,0,0,0" Padding="0,10" ToolTip="Application options"/></Grid>
     </StackPanel>
    </StackPanel>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Grid Background="#111214">
  <Grid.RowDefinitions><RowDefinition Height="63"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="39"/></Grid.RowDefinitions>
  <Border BorderBrush="#35373B" BorderThickness="0,0,0,1" Padding="22,0"><DockPanel LastChildFill="False">
   <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="TMApps" FontSize="25" FontWeight="Bold"/><Border Background="#F2F3F4" Margin="21,0,0,0" VerticalAlignment="Center" Padding="9,5"><TextBlock Text="LAUNCHER" Foreground="#101214" FontFamily="Consolas" FontWeight="Bold" FontSize="10"/></Border><TextBlock Text="YOUR APPLICATION LIBRARY" Foreground="#777E84" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="20,0,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ViewButton" Content="▦  Grid" Click="ViewClick" Margin="0,0,8,0"/><Button x:Name="RefreshButton" Content="↻  Check updates" Click="RefreshClick" Margin="0,0,8,0"/><Button Content="⚙" Click="SettingsClick" ToolTip="Launcher settings" AutomationProperties.Name="Launcher settings" Padding="12,9"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Row="1" Margin="22,20,22,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><Button x:Name="AllFilter" Content="All apps  2" Tag="all" Click="FilterClick"/><Button x:Name="InstalledFilter" Content="Installed  0" Tag="installed" Click="FilterClick" Margin="-1,0,0,0"/><Button x:Name="UpdatesFilter" Content="Updates  0" Tag="updates" Click="FilterClick" Margin="-1,0,0,0"/><Button x:Name="NotInstalledFilter" Content="Not installed  2" Tag="notinstalled" Click="FilterClick" Margin="-1,0,0,0"/></StackPanel>
   <Grid Grid.Column="2"><TextBox x:Name="Search" TextChanged="SearchChanged" ToolTip="Search applications" AutomationProperties.Name="Search applications"/><TextBlock Text="Search apps…" Foreground="#858D93" VerticalAlignment="Center" Margin="13,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
  </Grid>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="22,0,22,20">
   <DockPanel Margin="0,0,0,12"><TextBlock x:Name="LibraryLabel" Text="APPLICATION LIBRARY / 02" Foreground="#7D868C" FontFamily="Consolas" FontSize="10"/><TextBlock Text="WINDOWS X64" Foreground="#7D868C" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
   <ItemsControl x:Name="Cards" ItemTemplate="{StaticResource AppList}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
   <TextBlock x:Name="Empty" Text="No applications match this view." Foreground="#A0A8AF" Visibility="Collapsed" Margin="0,25"/>
   <TextBlock x:Name="Notice" Text="Choose an application to install. Downloads and installation happen here." Foreground="#8B959D" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="3" BorderBrush="#35373B" BorderThickness="0,1,0,0" Padding="22,0"><DockPanel><TextBlock x:Name="Footer" Text="TMAPPS LAUNCHER 1.1.0 · WINDOWS X64" Foreground="#7E878D" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/><Button Content="GITHUB ↗" Click="GitHubClick" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="0,7"/></DockPanel></Border>
 </Grid>
</Window>
