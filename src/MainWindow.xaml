<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TMApps Launcher" Width="1120" Height="720" MinWidth="1000" MinHeight="580" Background="#17191F" Foreground="#ECEEF3" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#ECEEF3"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Option" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="#5B321E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#ECEEF3"/><Setter Property="Background" Value="#2D313B"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#2D313B" BorderBrush="#393F4B" BorderThickness="1" CornerRadius="17" Padding="13,10"><TextBlock Text="⌄" Foreground="#ECEEF3" HorizontalAlignment="Right"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="14,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"><Border Background="#2D313B" BorderBrush="#393F4B" BorderThickness="1" CornerRadius="14" Padding="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="250"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#2D313B"/><Setter Property="Foreground" Value="#D9DCDE"/><Setter Property="BorderBrush" Value="#393F4B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,10"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" CornerRadius="17" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#F68B40"/><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#F68B40"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#22252C"/><Setter Property="Foreground" Value="#ECEEF3"/><Setter Property="BorderBrush" Value="#393F4B"/><Setter Property="Padding" Value="14,10"/><Setter Property="CaretBrush" Value="#ECEEF3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Field" CornerRadius="17" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#F68B40"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="#22252C"/><Setter Property="Foreground" Value="#ECEEF3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="#393F4B" BorderThickness="1" CornerRadius="15" Padding="7"><ItemsPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#ECEEF3"/><Setter Property="Padding" Value="13,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Item" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#3A2C25"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Item" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <DataTemplate x:Key="AppList">
   <Border BorderBrush="#393F4B" BorderThickness="1" Margin="0,0,0,14" CornerRadius="18" Background="#22252C">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="33"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border BorderBrush="#393F4B" BorderThickness="0,0,0,1" Padding="16,0"><DockPanel><TextBlock Text="{Binding Number}" Foreground="{Binding Accent}" FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="{Binding Category}" Foreground="#8C9296" FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel></Border>
     <Grid Grid.Row="1" Margin="20,23">
      <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="184"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
      <Border Width="56" Height="56" Background="{Binding PreviewBackground}" CornerRadius="9" VerticalAlignment="Top"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" Margin="0,0,25,0"><TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="#A9B0C0" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,7,0,0"/><TextBlock Text="{Binding Detail}" Foreground="#A6B2AC" FontSize="12" TextWrapping="Wrap" Margin="0,11,0,0"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="0,4,12,0"><TextBlock Text="{Binding Status}" Foreground="{Binding Accent}" FontSize="11" FontFamily="Segoe UI" TextWrapping="Wrap"/><TextBlock Text="{Binding VersionLabel}" Foreground="#D7DADD" FontSize="12" Margin="0,14,0,0"/><TextBlock Text="{Binding UpdatedLabel, StringFormat=Updated {0}}" Foreground="#A9B0C0" FontSize="12" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="3" VerticalAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><Button Content="{Binding Action}" IsEnabled="{Binding CanAct}" Tag="{Binding Id}" Click="AppAction" FontWeight="SemiBold" Background="#CC5500" Foreground="White" BorderThickness="0"/><Button Grid.Column="1" Content="•••" Tag="{Binding Id}" Click="AppMenu" ToolTip="Application options" Margin="6,0,0,0" Padding="0,10" AutomationProperties.Name="Application options"/></Grid><Button Content="Cancel" Tag="{Binding Id}" Click="CancelInstall" Visibility="{Binding CancelVisibility}" Margin="0,6,0,0"/></StackPanel>
     </Grid>
    </Grid>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="AppCard">
   <Border Margin="0,0,12,14" CornerRadius="18" BorderBrush="#393F4B" BorderThickness="1" Background="#22252C">
    <StackPanel>
     <Border BorderBrush="#393F4B" BorderThickness="0,0,0,1" Padding="18,10"><TextBlock Text="{Binding Number}" Foreground="{Binding Accent}" FontFamily="Segoe UI" FontSize="11"/></Border>
     <StackPanel Margin="20,22">
      <DockPanel><Border Width="54" Height="54" Background="{Binding PreviewBackground}" CornerRadius="8" Margin="0,0,14,0"><TextBlock Text="{Binding Glyph}" Foreground="{Binding Accent}" FontFamily="Segoe MDL2 Assets" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Foreground="#A9B0C0" FontSize="12" Margin="0,4,0,0"/></StackPanel></DockPanel>
      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#A9B0C0" FontSize="12" LineHeight="20" Margin="0,17,0,0" MinHeight="44"/>
      <TextBlock Text="{Binding Status}" Foreground="{Binding Accent}" FontFamily="Segoe UI" FontSize="11" Margin="0,18,0,0"/>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="{Binding VersionLabel}" FontSize="12" Foreground="#A8ADB2"/><TextBlock Text=" · " Foreground="#A8ADB2"/><TextBlock Text="{Binding UpdatedLabel}" FontSize="12" Foreground="#A8ADB2"/></StackPanel>
      <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Foreground="#9BA8A1" FontSize="12" Margin="0,10,0,0" MinHeight="16"/>
      <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><Button Content="{Binding Action}" IsEnabled="{Binding CanAct}" Tag="{Binding Id}" Click="AppAction" FontWeight="SemiBold" Background="#CC5500" Foreground="White" BorderThickness="0"/><Button Grid.Column="1" Content="Cancel" Tag="{Binding Id}" Click="CancelInstall" Visibility="{Binding CancelVisibility}" Margin="6,0,0,0"/><Button Grid.Column="2" Content="•••" Tag="{Binding Id}" Click="AppMenu" Margin="6,0,0,0" Padding="0,10" ToolTip="Application options"/></Grid>
     </StackPanel>
    </StackPanel>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <DockPanel x:Name="Shell" Background="#17191F" LastChildFill="True">
  <Border x:Name="NavigationPanel" DockPanel.Dock="Left" Width="214" Background="#412313" Padding="10,14">
   <WrapPanel x:Name="NavigationLayout" Orientation="Vertical">
    <StackPanel x:Name="BrandBlock" Orientation="Horizontal" Margin="8,7,8,24" VerticalAlignment="Center"><Image x:Name="BrandIcon" Width="34" Height="34" Margin="0,0,10,0"/><StackPanel x:Name="BrandTitle"><TextBlock Text="TMApps" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Launcher" FontSize="11" Foreground="#F4BE93"/></StackPanel></StackPanel>
    <StackPanel x:Name="NavActions">
     <Button x:Name="CompactButton" Content="☰  Collapse navigation" Tag="compact" Margin="0,0,0,14" Background="Transparent" BorderThickness="0"/>
     <Button x:Name="AllFilter" Content="All applications  2" Tag="all" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>
     <Button x:Name="InstalledFilter" Content="Installed  0" Tag="installed" Margin="0,0,0,8"/>
     <Button x:Name="UpdatesFilter" Content="Updates  0" Tag="updates" Margin="0,0,0,8"/>
     <Button x:Name="NotInstalledFilter" Content="Not installed  2" Tag="notinstalled" Margin="0,0,0,8"/>
    </StackPanel>
    <StackPanel x:Name="NavUtilities" Margin="0,22,0,0">
     <Button x:Name="RefreshButton" Content="↻  Check updates" Margin="0,0,0,8"/>
     <Button x:Name="SettingsButton" Content="⚙  Settings" Margin="0,0,0,8"/>
     <Button x:Name="GitHubButton" Content="GitHub ↗" Margin="0,0,0,8" Background="Transparent" BorderThickness="0"/>
    </StackPanel>
   </WrapPanel>
  </Border>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
   <StackPanel Margin="26,24,26,20">
    <DockPanel><TextBlock Text="Your applications" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="TMApps / Library" Foreground="#A9B0C0" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
    <TextBlock Text="A home for your tools. Install, open, and keep everything up to date." Foreground="#A9B0C0" FontSize="12" Margin="0,9,0,21"/>
    <Grid Height="42"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid Margin="0,0,20,0" MaxWidth="360" HorizontalAlignment="Left" Width="300"><TextBox x:Name="Search" ToolTip="Search applications" AutomationProperties.Name="Search applications"/><TextBlock Text="Search applications…" Foreground="#A9B0C0" VerticalAlignment="Center" Margin="15,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ListViewButton" Content="☷  List" Margin="0,0,7,0"/><Button x:Name="GridViewButton" Content="▦  Grid"/></StackPanel>
    </Grid>
   </StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,0,26,24">
    <TextBlock x:Name="LibraryLabel" Text="APPLICATION LIBRARY / 02" Foreground="#A9B0C0" FontSize="11" Margin="0,0,0,13"/>
    <ItemsControl x:Name="Cards" ItemTemplate="{StaticResource AppList}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
    <TextBlock x:Name="Empty" Text="No applications match this view." Foreground="#A9B0C0" Visibility="Collapsed" Margin="0,25"/>
    <TextBlock x:Name="Notice" Text="Choose an application to install." Foreground="#A9B0C0" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="2" Background="#22252C" Padding="26,0"><TextBlock x:Name="Footer" Text="TMApps Launcher 1.3.0 · DaddyTylerXO · Windows x64" Foreground="#A9B0C0" FontSize="10" VerticalAlignment="Center"/></Border>
  </Grid>
 </DockPanel>
</Window>
