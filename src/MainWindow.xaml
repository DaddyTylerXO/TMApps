<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TMApps Launcher" Width="1180" Height="840" MinWidth="880" MinHeight="700" Background="#101213" Foreground="#F1F3F1" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#919A96"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#202725"/><Setter Property="Foreground" Value="#D9DFDB"/><Setter Property="BorderBrush" Value="#343D38"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#BEF18A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#171B19"/><Setter Property="Foreground" Value="#E7EDE8"/><Setter Property="BorderBrush" Value="#343D38"/><Setter Property="Padding" Value="12,10"/><Setter Property="CaretBrush" Value="#BEF18A"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="9,8"/><Setter Property="MinWidth" Value="145"/></Style>
  <DataTemplate x:Key="AppCard">
   <Border Margin="0,0,18,18" Background="#191E1B" BorderBrush="#343C36" BorderThickness="1" CornerRadius="9">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="148"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="{Binding PreviewBackground}" CornerRadius="8,8,0,0" ClipToBounds="True">
      <Grid>
       <Canvas Opacity="0.14" IsHitTestVisible="False"><Ellipse Width="250" Height="250" Stroke="{Binding Accent}" StrokeThickness="1" Canvas.Left="255" Canvas.Top="-120"/><Ellipse Width="320" Height="320" Stroke="{Binding Accent}" StrokeThickness="1" Canvas.Left="220" Canvas.Top="-155"/><Ellipse Width="390" Height="390" Stroke="{Binding Accent}" StrokeThickness="1" Canvas.Left="185" Canvas.Top="-190"/></Canvas>
       <TextBlock Text="{Binding Number}" Foreground="{Binding Accent}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,16"/>
       <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="82" Height="70" CornerRadius="16" BorderThickness="1" BorderBrush="{Binding Accent}" Background="#18221C"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <TextBlock Text="{Binding Category}" Foreground="{Binding Accent}" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20,15"/>
      </Grid>
     </Border>
     <Grid Grid.Row="1" Margin="22,20,22,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel><TextBlock Text="BETA" DockPanel.Dock="Right" FontFamily="Consolas" Foreground="#AAB2AC" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" FontSize="23" FontWeight="SemiBold"/></DockPanel>
      <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13" LineHeight="21" Margin="0,9,0,0" MinHeight="46"/>
      <DockPanel Grid.Row="2" Margin="0,17,0,0"><TextBlock Text="{Binding VersionLabel}" DockPanel.Dock="Right" Foreground="#919A96" FontFamily="Consolas" FontSize="11"/><TextBlock Text="{Binding Status}" Foreground="{Binding Accent}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"/></DockPanel>
      <TextBlock Grid.Row="3" Text="{Binding Detail}" ToolTip="{Binding Detail}" TextTrimming="CharacterEllipsis" Foreground="#B8C1BA" FontSize="11" Margin="0,8,0,0" MinHeight="16"/>
      <Grid Grid.Row="4" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button Content="{Binding Action}" IsEnabled="{Binding CanAct}" Tag="{Binding Id}" Click="AppAction" Background="{Binding Accent}" Foreground="#101A12" BorderThickness="0" FontWeight="SemiBold" Padding="16,11"/>
       <Button Grid.Column="1" Content="Cancel" Tag="{Binding Id}" Click="CancelInstall" Visibility="{Binding CancelVisibility}" Margin="8,0,0,0"/>
       <Button Grid.Column="2" Content="•••" Tag="{Binding Id}" Click="AppMenu" ToolTip="Application options" Margin="8,0,0,0" AutomationProperties.Name="Application options"/>
      </Grid>
     </Grid>
    </Grid>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Grid Background="#101213">
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="43"/></Grid.RowDefinitions>
  <Border BorderBrush="#2D3530" BorderThickness="0,0,0,1" Padding="28,0">
   <DockPanel LastChildFill="False">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center"><Border Background="#BEF18A" CornerRadius="7" Padding="8,7"><TextBlock Text="TM" Foreground="#142015" FontWeight="ExtraBold" FontSize="19"/></Border><TextBlock Text="TMApps" FontSize="23" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/><Border Background="#252E26" CornerRadius="4" Padding="9,5" Margin="18,0,0,0" VerticalAlignment="Center"><TextBlock Text="LAUNCHER" Foreground="#BEF18A" FontSize="10" FontFamily="Consolas"/></Border></StackPanel>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Button x:Name="RefreshButton" Content="↻  Check for updates" Click="RefreshClick" Margin="0,0,10,0"/><Button Content="⚙" Click="SettingsClick" ToolTip="Launcher settings" AutomationProperties.Name="Launcher settings" FontSize="16" Padding="12,7"/></StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="34,32,16,20">
    <TextBlock Text="YOUR APPS. ONE PLACE." Foreground="#BEF18A" FontFamily="Consolas" FontSize="11"/>
    <TextBlock Text="Good work starts here." FontSize="36" FontWeight="SemiBold" Margin="0,8,0,0"/>
    <TextBlock Text="Install, open, and keep your TMApps up to date." Foreground="#919A96" FontSize="14" Margin="0,9,0,0"/>
    <Border Background="#182019" BorderBrush="#303F30" BorderThickness="1" CornerRadius="6" Padding="13,10" Margin="0,23,18,0"><TextBlock x:Name="Notice" Text="Your library is ready." Foreground="#B5C8B4" TextWrapping="Wrap" FontSize="12"/></Border>
    <Grid Margin="0,25,18,20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal"><Button x:Name="AllFilter" Content="All apps  2" Tag="all" Click="FilterClick"/><Button x:Name="InstalledFilter" Content="Installed  0" Tag="installed" Click="FilterClick" Margin="6,0,0,0"/><Button x:Name="UpdatesFilter" Content="Updates  0" Tag="updates" Click="FilterClick" Margin="6,0,0,0"/></StackPanel>
     <Grid Grid.Column="2">
      <TextBox x:Name="Search" TextChanged="SearchChanged" ToolTip="Search applications" AutomationProperties.Name="Search applications"/>
      <TextBlock Text="Search apps…" Foreground="#879389" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     <Button Grid.Column="3" x:Name="ViewButton" Content="☷  List" Click="ViewClick" Margin="8,0,0,0" ToolTip="Toggle grid and list"/>
    </Grid>
    <DockPanel Margin="0,0,18,14"><TextBlock x:Name="LibraryLabel" Text="APPLICATION LIBRARY / 02" FontFamily="Consolas" FontSize="10" Foreground="#879389"/><TextBlock Text="WINDOWS 10 / 11 · X64" Foreground="#737E76" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
    <ItemsControl x:Name="Cards" ItemTemplate="{StaticResource AppCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
    <TextBlock x:Name="Empty" Text="No apps match this view. Try All apps or a different search." Visibility="Collapsed" Foreground="#B5C8B4" Margin="0,22"/>
    <TextBlock Text="A growing collection. More tools, same home." FontSize="12" Foreground="#6E7B71" Margin="0,3,0,0"/>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" BorderBrush="#2D3530" BorderThickness="0,1,0,0" Padding="28,0"><DockPanel><TextBlock x:Name="Footer" Text="●  TMApps Launcher 1.0.0" Foreground="#879389" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/><Button Content="GITHUB ↗" Click="GitHubClick" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="10" Padding="0,8"/></DockPanel></Border>
 </Grid>
</Window>
