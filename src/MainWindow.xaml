<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TMA-Mail" Width="1420" Height="900" MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterScreen" Background="{DynamicResource TF5F7FB}" FontFamily="Segoe UI" Foreground="{DynamicResource T17243B}">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource T53617A}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource T7DAFFF}"/><Setter TargetName="bg" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bg" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="{DynamicResource TB7C6DF}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="12,3"/><Setter Property="Padding" Value="15,12"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource TSurface}"/><Setter Property="Foreground" Value="{DynamicResource TText}"/><Setter Property="CaretBrush" Value="{DynamicResource TText}"/><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="{DynamicResource TDDE4EF}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="row" Background="{DynamicResource TSurface}" BorderBrush="{DynamicResource TEDF0F5}" BorderThickness="0,0,0,1"><Border x:Name="marker" BorderBrush="Transparent" BorderThickness="3,0,0,0"><ContentPresenter/></Border></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource TF6F8FC}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource TEDF3FF}"/><Setter TargetName="marker" Property="BorderBrush" Value="{DynamicResource T447EF2}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="365" MinWidth="290"/><ColumnDefinition Width="*" MinWidth="420"/></Grid.ColumnDefinitions>
    <Border Grid.RowSpan="3" Background="{DynamicResource T14243E}"/>
    <StackPanel Orientation="Horizontal" Margin="25,0" VerticalAlignment="Center">
      <Border Background="{DynamicResource T4D83F5}" CornerRadius="8" Width="31" Height="31"><TextBlock Text="✉" Foreground="White" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock x:Name="BrandLabel" Text="TMA-Mail" FontSize="19" FontWeight="SemiBold" Foreground="White" Margin="10,0,0,2"/>
    </StackPanel>
    <Border Grid.Column="1" Grid.ColumnSpan="2" Background="{DynamicResource TSurface}" BorderBrush="{DynamicResource TE4E9F1}" BorderThickness="0,0,0,1">
      <Grid Margin="25,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource TF2F5F9}" CornerRadius="7" Width="440" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="12,0"><DockPanel><TextBlock Text="⌕" FontSize="24" Foreground="{DynamicResource T8090A8}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock DockPanel.Dock="Right" Text="Ctrl F" FontSize="11" Foreground="{DynamicResource T8090A8}" VerticalAlignment="Center" Margin="8,0,0,0"/><Grid><TextBox x:Name="SearchBox" AutomationProperties.Name="Search current folder" ToolTip="Search this folder (Ctrl+F)" Background="Transparent" BorderThickness="0" Height="37"/><TextBlock Text="Search this folder" IsHitTestVisible="False" Foreground="{DynamicResource T8793A7}" VerticalAlignment="Center" Margin="10,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel></Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource TECF2FF}" CornerRadius="4" Padding="9,5" Margin="0,0,16,0"><TextBlock x:Name="WorkspaceBadge" Text="EXPLORE MODE" Foreground="{DynamicResource T5378B8}" FontSize="10" FontWeight="SemiBold"/></Border><Button x:Name="AccountTop" ToolTip="Account connections" Padding="0"><Border Background="{DynamicResource TDDE8FD}" CornerRadius="18" Width="34" Height="34"><TextBlock Text="T" Foreground="{DynamicResource T3566B9}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Button></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Button x:Name="ComposeButton" Content="＋   New message" Background="{DynamicResource T4D83F5}" Foreground="White" FontWeight="SemiBold" Margin="18,20,18,26" Padding="14,12"/>
      <StackPanel Grid.Row="1">
        <TextBlock Text="YOUR MAILBOX" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource T7084A3}" Margin="27,0,0,13"/>
        <Button x:Name="InboxNav" Tag="Inbox" Style="{StaticResource Nav}"><DockPanel><TextBlock Text="▣" Width="27"/><TextBlock x:Name="InboxCount" DockPanel.Dock="Right" HorizontalAlignment="Right"/><TextBlock Text="Inbox"/></DockPanel></Button>
        <Button x:Name="StarredNav" Tag="Starred" Style="{StaticResource Nav}" Content="☆     Starred"/>
        <Button x:Name="DraftsNav" Tag="Drafts" Style="{StaticResource Nav}"><DockPanel><TextBlock Text="▱" Width="27"/><TextBlock x:Name="DraftCount" DockPanel.Dock="Right" HorizontalAlignment="Right"/><TextBlock Text="Drafts"/></DockPanel></Button>
        <Button x:Name="SentNav" Tag="Sent" Style="{StaticResource Nav}" Content="↗     Sent"/>
        <Button x:Name="ArchiveNav" Tag="Archive" Style="{StaticResource Nav}" Content="▤     Archive"/>
        <Button x:Name="TrashNav" Tag="Trash" Style="{StaticResource Nav}" Content="♧     Trash"/>
        <Border Background="{DynamicResource T2A3A53}" Height="1" Margin="26,23,26,22"/>
        <TextBlock Text="A LITTLE MORE FOCUS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource T7084A3}" Margin="27,0,0,10"/>
        <TextBlock Text="A home for your conversations.&#10;A little space for your day." Foreground="{DynamicResource T8E9FB9}" FontSize="12" LineHeight="21" Margin="27,0,18,0"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Margin="18,20,18,18"><Button x:Name="AccountsButton" Content="＋   Connect an account" Foreground="{DynamicResource TC5D4EC}" HorizontalContentAlignment="Left" Padding="8,12"/><Border Background="{DynamicResource T20324E}" CornerRadius="8" Padding="12" Margin="0,10,0,0"><StackPanel><TextBlock Text="Your local workspace" Foreground="{DynamicResource TDCE6F7}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Sample mail · stored on this PC" Foreground="{DynamicResource T8DA2C1}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border></StackPanel>
    </Grid>
    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource TSurface}" BorderBrush="{DynamicResource TE3E8F1}" BorderThickness="0,0,1,0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="23,23,23,0"><DockPanel><TextBlock x:Name="FolderHeading" Text="Inbox" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="FolderCount" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource T8090A8}" FontSize="12"/></DockPanel><TextBlock x:Name="FolderSubtitle" Text="A fresh perspective on your day." Foreground="{DynamicResource T8793A7}" FontSize="12" Margin="0,7,0,17"/><DockPanel Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Button x:Name="AllFilter" Content="All mail" Background="{DynamicResource TEDF3FF}" Foreground="{DynamicResource T386FD4}" Padding="12,6" FontWeight="SemiBold"/><Button x:Name="UnreadFilter" Content="Unread" Margin="5,0,0,0" Padding="12,6"/></StackPanel><TextBlock Text="Newest first" Foreground="{DynamicResource T929DB0}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></StackPanel>
        <Grid Grid.Row="1"><ListBox VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" x:Name="MessageList" BorderThickness="0" Background="{DynamicResource TSurface}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate><DataTemplate><Grid Margin="17,17,17,17"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource TE8EEFA}" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top"><TextBlock Text="{Binding Initials}" FontSize="10" Foreground="{DynamicResource T5775A8}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><DockPanel><TextBlock Text="{Binding TimeLabel}" DockPanel.Dock="Right" Foreground="{DynamicResource T91A0B4}" FontSize="10" Margin="6,2,0,0"/><TextBlock Text="{Binding Sender}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Text="{Binding Subject}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource T4C5970}"/><Style.Triggers><DataTrigger Binding="{Binding Unread}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource T244B91}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Preview}" Foreground="{DynamicResource T8995A8}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/><TextBlock Text="{Binding FollowUpLabel}" FontSize="10" Foreground="{DynamicResource TBC9451}"/><TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TBC9451}"/><DockPanel Margin="0,8,0,0"><TextBlock Text="{Binding StarLabel}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource TBC9451}" FontSize="14"/><TextBlock Text="●" FontSize="8" Foreground="{DynamicResource T4D83F5}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding Unread}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox><StackPanel x:Name="EmptyList" Visibility="Collapsed" VerticalAlignment="Center" Margin="28"><TextBlock Text="All clear." FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="No messages match this view." Foreground="{DynamicResource T8793A7}" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel></Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Grid.Column="2" Background="{DynamicResource TF8FAFD}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource TSurface}" BorderBrush="{DynamicResource TE4E9F1}" BorderThickness="0,0,0,1"><DockPanel Margin="18,0"><WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5"><Button x:Name="ArchiveButton" Content="▤  Archive" ToolTip="Move to Archive"/><Button x:Name="DeleteButton" Content="♧  Delete" ToolTip="Move to Trash (Delete)"/><Border Background="{DynamicResource TE1E6EF}" Width="1" Margin="7,14"/><Button x:Name="ReadButton" Content="○  Mark unread"/></WrapPanel><Button x:Name="StarButton" Content="☆" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Toggle star"/></DockPanel></Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid Margin="32,29,32,25"><StackPanel x:Name="Reader">
        <TextBlock x:Name="SubjectText" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="34"/>
        <Border Background="{DynamicResource TSurface}" BorderBrush="{DynamicResource TE7EBF2}" BorderThickness="1" CornerRadius="10" Padding="25" Margin="0,23,0,0"><StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource TE9EDFC}" Width="38" Height="38" CornerRadius="19" VerticalAlignment="Top"><TextBlock x:Name="SenderInitials" FontSize="12" Foreground="{DynamicResource T6D6EB0}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock x:Name="SenderText" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="AddressText" Foreground="{DynamicResource T8793A7}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="DateText" Foreground="{DynamicResource T99A4B5}" FontSize="10" Margin="0,8,0,0"/></StackPanel></Grid>
          <Border Background="{DynamicResource TEDF0F5}" Height="1" Margin="0,22,0,20"/>
          <TextBox x:Name="BodyText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" FontSize="14" Foreground="{DynamicResource T4B5870}" Padding="0" Cursor="IBeam"/>
          <StackPanel Orientation="Horizontal" Margin="0,32,0,0"><Button x:Name="ReplyButton" Content="↶   Reply" Background="{DynamicResource T4D83F5}" Foreground="White" Padding="19,10"/><Button x:Name="ForwardButton" Content="↪   Forward" Background="{DynamicResource TF0F3F8}" Margin="10,0,0,0" Padding="19,10"/></StackPanel>
        </StackPanel></Border>
        <TextBlock Text="A little less noise. A little more focus." Foreground="{DynamicResource TA2ADBE}" FontSize="11" HorizontalAlignment="Center" Margin="0,25,0,0"/>
      </StackPanel><StackPanel x:Name="EmptyReader" Visibility="Collapsed" VerticalAlignment="Center" Margin="30,100"><TextBlock Text="✉" FontSize="55" Foreground="{DynamicResource TB1C3E1}" HorizontalAlignment="Center"/><TextBlock Text="Room to focus" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,8"/><TextBlock Text="Select a message, or start a new conversation." Foreground="{DynamicResource T8793A7}" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel></Grid></ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Background="{DynamicResource TSurface}" BorderBrush="{DynamicResource TE4E9F1}" BorderThickness="0,1,0,0"><DockPanel Margin="18,0"><Ellipse x:Name="ConnectionLamp" DockPanel.Dock="Right" Width="12" Height="12" Fill="#FF3B4D" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="No mailbox connected"/><Button x:Name="FooterSyncButton" DockPanel.Dock="Right" Content="↻ Sync" ToolTip="Sync selected mailbox" Height="25" Padding="9,2" FontSize="11" Margin="8,0,0,0"/><TextBlock x:Name="StatusText" Text="Connect an account to receive and send mail" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource T8A98AC}" VerticalAlignment="Center"/></DockPanel></Border>
  </Grid>
</Window>
