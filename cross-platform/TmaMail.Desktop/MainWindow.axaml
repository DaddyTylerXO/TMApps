<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:TmaMail.Desktop" x:Class="TmaMail.Desktop.MainWindow" x:DataType="local:MailboxViewModel" Title="TMA-Mail · Cross-platform Preview" Icon="avares://TmaMail.Desktop/Assets/TMA-Mail.ico" Width="1180" Height="780" MinWidth="820" MinHeight="520" Background="#181A20" FontFamily="Inter">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="#143B29" Padding="18,12"><Grid ColumnDefinitions="Auto,*"><TextBlock Text="TMA-Mail" FontSize="23" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="Cross-platform preview · sample mail only" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#AEDCC2"/></Grid></Border>
    <Grid Grid.Row="1" ColumnDefinitions="190,5,310,5,*">
      <Border Background="#0D2419" Padding="12"><StackPanel><TextBlock Text="Sample mailbox" Foreground="#B8D9C6" Margin="10,14"/><Button Classes="nav" Content="Inbox" Command="{Binding InboxCommand}"/><Button Classes="nav" Content="Sent" Command="{Binding SentCommand}"/><Button Classes="nav" Content="Trash" Command="{Binding TrashCommand}"/><TextBlock Text="No real accounts or messages are used in this preview." TextWrapping="Wrap" Foreground="#9BB3A5" Margin="10,28"/></StackPanel></Border>
      <GridSplitter Grid.Column="1" Background="#28533C" ResizeDirection="Columns"/>
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" Margin="12"><TextBlock Text="{Binding Folder}" FontSize="24" Margin="0,10"/><TextBox Grid.Row="1" Text="{Binding Search, Mode=TwoWay}" PlaceholderText="Search sample mail" Margin="0,0,0,12"/><ListBox Grid.Row="2" ItemsSource="{Binding Messages}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="#22252D" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="local:MessageRow"><StackPanel Margin="8,12"><TextBlock Text="{Binding Sender}" FontWeight="SemiBold"/><TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" Margin="0,5"/><TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" Foreground="#ABB7AD" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
      <GridSplitter Grid.Column="3" Background="#28533C" ResizeDirection="Columns"/>
      <Grid Grid.Column="4" RowDefinitions="Auto,*"><Border BorderBrush="#3A8C5E" BorderThickness="0,0,0,1" Padding="14"><WrapPanel><Button Classes="action" Content="{Binding ReadLabel}" Command="{Binding ReadCommand}"/><Button Classes="action" Content="☆ Toggle Star" Command="{Binding StarCommand}"/><Button Classes="action" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}"/></WrapPanel></Border><ScrollViewer Grid.Row="1"><StackPanel Margin="24"><TextBlock Text="{Binding Selected.Subject}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Selected.Sender}" Foreground="#B8D9C6" Margin="0,18"/><TextBlock Text="{Binding Selected.Body}" TextWrapping="Wrap" FontSize="15" LineHeight="25"/></StackPanel></ScrollViewer></Grid>
    </Grid>
    <Border Grid.Row="2" Padding="16,9" Background="#22252D"><TextBlock Text="{Binding Status}" Foreground="#B8D9C6" FontSize="12"/></Border>
  </Grid>
</Window>
